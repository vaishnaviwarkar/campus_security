# Server Configuration
PORT=5000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=campus_asset_security

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=24h

# File Uploads
UPLOAD_PATH=./uploads
MAX_FILE_SIZE_MB=5

# IoT & Camera Config
CHECKPOINT_DEFAULT_TIMEOUT_SEC=30
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
